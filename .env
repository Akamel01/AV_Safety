# Environment configuration for AV_Safety

# Data API keys (if using any external APIs)
# NHTSA_API_KEY=
# Kaggle_USERNAME=
# Kaggle_KEY=

# Database (if using one)
# DATABASE_URL=

# Output paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
OUTPUT_DIR=outputs

# Debug mode (set to 1 for verbose logging)
DEBUG=0

# Graphify / Ollama configuration
# Use cloud ollama model (gpt-oss:120b-cloud) for semantic extraction
# Switch to a local model by changing OLLAMA_MODEL and setting OLLAMA_BASE_URL
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=***

# Set GRAPHIFY_OLLAMA_PARALLEL=1 to allow concurrent semantic chunks (not recommended for local models)
# GRAPHIFY_OLLAMA_PARALLEL=
